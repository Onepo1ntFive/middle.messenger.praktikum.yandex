<section class='form'>
    <form action='' method='get'>
        <h1 class='form_title'>{{{ formData.title }}}</h1>
        <div class='form_items'>
            {{#each inputs}}
                <div class='form_item'>
                    {{{ this }}}
                </div>
            {{/each}}
        </div>
        <div class='form_btns'>
            {{{ Button }}}
            {{{ Link }}}
        </div>
    </form>
</section>