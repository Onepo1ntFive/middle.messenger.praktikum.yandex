<li class='page-chat_list-item{{#if active}} active{{/if}}' data-id='{{{id}}}'>
    <div class='page-chat_list-avatar'></div>
    <div class='page-chat_list-content'>
        <div class='page-chat_list-header'>
            <div class='page-chat_list-name'>
                {{{title}}}
            </div>
            <div class='page-chat_list-time' title='{{{date}}} {{{time}}}'>{{{time}}}</div>
        </div>
        <div class='page-chat_list-message'>
            {{#if last_message}}
                <p>{{{last_message.user.display_name}}}: {{{last_message.content}}}</p>
            {{/if}}
        </div>
        {{#if unread_count}}
            <div class='page-chat_list-unread'>{{{unread_count}}}</div>
        {{/if}}
    </div>
</li>
