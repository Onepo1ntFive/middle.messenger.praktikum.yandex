<div>
    <div class='input {{ class }}{{#if error}} error{{/if}}'>
        <input
            type='{{ type }}'
            id='{{ id }}'
            name='{{ name }}'
            placeholder="{{ placeholder }}"
            value='{{ value }}'
            {{#if disabled}}disabled='disabled'{{/if}}
            autocomplete='off'
        >
        <label for='{{ id }}'>{{{ label}}}</label>
    </div>
    {{#if error}}
        <div class='error'>{{{ error }}}</div>
    {{/if}}
</div>
