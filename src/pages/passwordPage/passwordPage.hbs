<form action='' method='get'>
    <div class='page-profile_avatar'>
        {{{ Avatar }}}
    </div>
    <div class='page-profile_nick-name'>{{{ user.display_name }}}</div>
    <div class='page-profile_list editable'>
        {{# each inputs }}
            <div class='page-profile_list-item'>
                {{{ this }}}
            </div>
        {{/each}}
    </div>
    <div class='page-profile_btns'>
        {{{ Button }}}
    </div>
</form>
