<form>
    <div class='page-profile_avatar'>
        {{{ Avatar }}}
    </div>
    <div class='page-profile_nick-name'>{{{ user.display_name }}} <span>{{{user.id}}}</span></div>
    <div class='page-profile_list{{#if settings.editProfile }} editable{{/if}}'>
        {{# each inputs }}
            <div class='page-profile_list-item'>
                {{{ this }}}
            </div>
        {{/each}}
    </div>
    {{#if settings.editProfile }}
        <div class='page-profile_btns'>
            {{{ Button }}}
        </div>
    {{else}}
        <div class='page-profile_list'>
            <div class='page-profile_list-item'>{{{ LinkEdit }}}</div>
            <div class='page-profile_list-item'>{{{ LinkPassword }}}</div>
            <div class='page-profile_list-item'>{{{ LinkLogout }}}</div>
        </div>
    {{/if}}
</form>
