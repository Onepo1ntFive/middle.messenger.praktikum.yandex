<section class='page-chat'>
    {{#if isLoading }}
        <div class='loader'></div>
    {{/if}}
    <aside class='page-chat_sidebar'>
        <header class='page-chat_header'>
            <div class='page-chat_nav'>
                {{{ Link }}}
            </div>
            <div class='page-chat_search'>
                <form action='' method='get'>
                    {{{ InputSearch }}}
                </form>
            </div>
        </header>
        <li class='page-chat_list-item'>
            <form>
                {{{ InputNew }}}
                {{{ ButtonNew }}}
            </form>
        </li>
        {{{ ChatsList }}}
    </aside>
    <main class='page-chat_chat'>
        {{#if currentChat.id }}
            <header class='page-chat_chat-header'>
                <div class='page-chat_chat-user'>
                    <div class='page-chat_chat-user-avatar'>
                        {{#if currentChat.avatar }}
                            <img src='https://ya-praktikum.tech/api/v2/resources{{{currentChat.avatar}}}' alt=''>
                        {{/if}}
                    </div>
                    {{{currentChat.title}}}
                </div>
                <div class='page-chat_menu'>
                    <div class='page-chat_menu-icon'><img src='/images/icon-menu.svg' alt='menu'></div>
                    <ul class='page-chat_menu-list'>
                        <li><img src='/images/icon-add.svg' alt='add'> Добавить пользователя</li>
                        <li><img src='/images/icon-delete.svg' alt='delete'> Удалить пользователя</li>
                    </ul>
                </div>
            </header>
            <section class='page-chat_chat-list'>
                <div class='page-chat_chat-date'>19 июня</div>
                <div class='page-chat_chat-message'>
                    <p>Lorem ipsum dolor sit amet, consectetur adipisicing elit. Autem commodi ea minima pariatur tempora? Earum error id ipsum, omnis quia quis sint soluta voluptates. Aliquam ducimus eaque earum enim nostrum!</p>
                    <p>Beatae consectetur doloremque hic nostrum placeat tempore voluptates? Aspernatur assumenda blanditiis cumque, distinctio dolor esse eum explicabo fuga id modi neque nisi nobis perferendis quaerat quasi quo repellat temporibus, vel!</p>
                    <p>Consectetur distinctio neque non, possimus provident quo quos ratione reiciendis sunt voluptatum. Aspernatur at distinctio, exercitationem hic in iste optio sit voluptatibus? Dolorum id illo nostrum odio officiis perferendis quibusdam.</p>
                    <div class='page-chat_chat-time'>11:56</div>
                </div>
                <div class='page-chat_chat-message page-chat_chat-message--media'>
                    <img src='/images/chat-media.jpg' alt='media'>
                    <div class='page-chat_chat-time'>11:56</div>
                </div>
                <div class='page-chat_chat-message page-chat_chat-message--user page-chat_chat-message--read'>
                    <p>Чо?!</p>
                    <div class='page-chat_chat-time'>11:57</div>
                </div>
            </section>
            <footer class='page-chat_chat-footer'>
                <div class='page-chat_menu page-chat_menu--up'>
                    <div class='page-chat_menu-icon'><img src='/images/icon-attach.svg' alt='attach'></div>
                    <ul class='page-chat_menu-list'>
                        <li><img src='/images/icon-media.svg' alt='media'> Фото или Видео</li>
                        <li><img src='/images/icon-file.svg' alt='file'> Файл</li>
                        <li><img src='/images/icon-geo.svg' alt='geo'> Локация</li>
                    </ul>
                </div>
                <form action='' method='get'>
                    <div class='page-chat_chat-input'>
                        {{{ Input }}}
                    </div>
                    {{{ Button }}}
                </form>
            </footer>
        {{else}}
            <div class='page-chat_chat-nochat'>Чат.. выбери..</div>
        {{/if}}
    </main>
</section>
