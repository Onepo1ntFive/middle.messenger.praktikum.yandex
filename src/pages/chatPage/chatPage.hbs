<section class='page-chat'>
    {{#if isLoading }}
        <div class='loader'></div>
    {{/if}}
    <aside class='page-chat_sidebar'>
        <header class='page-chat_header'>
            <div class='page-chat_nav'>
                {{{ Link }}}
            </div>
            <div class='page-chat_search'>
                <form>
                    {{{ InputSearch }}}
                </form>
            </div>
        </header>
        <li class='page-chat_list-item'>
            <form>
                {{{ InputNew }}}
                {{{ ButtonNew }}}
            </form>
        </li>
        {{{ ChatsList }}}
    </aside>
    <main class='page-chat_chat'>
        {{#if currentChat.id }}
            <header class='page-chat_chat-header'>
                <div class='page-chat_chat-user'>
                    <div class='page-chat_chat-user-avatar'>
                        {{#if currentChat.avatar }}
                            <img src='https://ya-praktikum.tech/api/v2/resources{{{currentChat.avatar}}}' alt=''>
                        {{/if}}
                    </div>
                    {{{currentChat.title}}}
                </div>

                {{{ ChatMenu }}}

            </header>
            <section class='page-chat_chat-list'>
                <div>
                    {{#each chatMessages }}
                        {{{this}}}
                    {{/each}}
                </div>
            </section>
            <footer class='page-chat_chat-footer'>
                <div class='page-chat_menu page-chat_menu--up'>
                    <div class='page-chat_menu-icon'><img src='/images/icon-attach.svg' alt='attach'></div>
                    <ul class='page-chat_menu-list'>
                        <li><img src='/images/icon-media.svg' alt='media'> Фото или Видео</li>
                        <li><img src='/images/icon-file.svg' alt='file'> Файл</li>
                        <li><img src='/images/icon-geo.svg' alt='geo'> Локация</li>
                    </ul>
                </div>
                <form>
                    <div class='page-chat_chat-input'>
                        {{{ Input }}}
                    </div>
                    {{{ Button }}}
                </form>
            </footer>
        {{else}}
            <div class='page-chat_chat-nochat'>ヽ(°〇°)ﾉ Чат.. выбери..</div>
        {{/if}}
    </main>
</section>
