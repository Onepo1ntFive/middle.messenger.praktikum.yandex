{
    "name": "middle.messenger.praktikum.yandex",
    "version": "1.0.0",
    "type": "module",
    "engines": {
        "node": ">=16"
    },
    "scripts": {
        "start": "npm run build && vite preview --port 3000",
        "dev": "vite",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint --fix .",
        "lint:style": "stylelint **/*.sass",
        "lint:style:fix": "stylelint --fix **/*.sass",
        "test": "./node_modules/.bin/mocha --require ts-node/esm src/**/*.spec.ts"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/chai": "^5.2.3",
        "@types/handlebars": "^4.0.40",
        "@types/mocha": "^10.0.10",
        "@types/node": "^25.6.2",
        "@types/sinon": "^21.0.1",
        "@typescript-eslint/eslint-plugin": "^8.58.0",
        "@typescript-eslint/parser": "^8.58.0",
        "chai": "^6.2.2",
        "eslint": "^10.0.3",
        "globals": "^17.4.0",
        "husky": "^9.1.7",
        "jiti": "^2.6.1",
        "jsdom": "^29.1.1",
        "mocha": "^11.7.5",
        "normalize.css": "^8.0.1",
        "postcss-sass": "^0.5.0",
        "sass": "^1.94.2",
        "sinon": "^22.0.0",
        "stylelint": "^17.4.0",
        "stylelint-config-standard": "^40.0.0",
        "stylelint-config-standard-scss": "^17.0.0",
        "ts-node": "^10.9.2",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.58.0",
        "vite": "^7.2.4",
        "vite-plugin-handlebars": "^2.0.0"
    },
    "dependencies": {
        "uuid": "^13.0.0"
    }
