{
    "name": "middle.messenger.praktikum.yandex",
    "version": "1.0.0",
    "type": "module",
    "engines": {
        "node": ">=16"
    },
    "scripts": {
        "start": "npm run build && vite preview --port 3000",
        "dev": "vite",
